# Copier ce fichier en .env puis remplacer les valeurs.
# .env est ignore par Git : ne jamais le commiter.

# --- PostgreSQL ---
POSTGRES_USER=thermoflux
POSTGRES_PASSWORD=change_me
POSTGRES_DB=thermoflux

# --- Mosquitto : un mot de passe par compte (utilisateurs fixes : simulateur, ingestion) ---
MQTT_SIMULATEUR_PASSWORD=change_me
MQTT_INGESTION_PASSWORD=change_me_too
